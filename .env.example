# IF4031 Milestone 1 — Environment Variables Example
# Copy this file to .env and fill in real values.
# DO NOT commit .env to version control.

# ─────────────────────────────────────────────
# BMKG Mock (port 8081)
# ─────────────────────────────────────────────
BMKG_API_KEY=change-me-bmkg-api-key
BMKG_DELAY_MIN_MS=50
BMKG_DELAY_MAX_MS=150
BMKG_EVENT_INTERVAL_S=10
BMKG_PORT=8081

# ─────────────────────────────────────────────
# PVMBG Mock (port 8082)
# ─────────────────────────────────────────────
PVMBG_BEARER_TOKEN=change-me-pvmbg-bearer-token
PVMBG_DELAY_MIN_MS=500
PVMBG_DELAY_MAX_MS=3000
PVMBG_EVENT_INTERVAL_S=10
PVMBG_PORT=8082

# ─────────────────────────────────────────────
# Aggregator
# ─────────────────────────────────────────────
AGGREGATOR_BMKG_BASE_URL=http://bmkg-mock:8081
AGGREGATOR_BMKG_API_KEY=change-me-bmkg-api-key      # must match BMKG_API_KEY
AGGREGATOR_BMKG_TIMEOUT_MS=1000

AGGREGATOR_PVMBG_BASE_URL=http://pvmbg-mock:8082
AGGREGATOR_PVMBG_BEARER_TOKEN=change-me-pvmbg-bearer-token  # must match PVMBG_BEARER_TOKEN
AGGREGATOR_PVMBG_TIMEOUT_MS=4000
AGGREGATOR_PVMBG_CB_THRESHOLD=3
AGGREGATOR_PVMBG_CB_PROBE_INTERVAL=30

AGGREGATOR_POLL_INTERVAL_S=3

AGGREGATOR_DB_DSN=postgres://aggregator:change-me-pg-password@canonical-store:5432/canonical

AGGREGATOR_NATS_URL=nats://nats-jetstream:4222
AGGREGATOR_PORT=8090

# ─────────────────────────────────────────────
# Canonical Store (PostgreSQL)
# ─────────────────────────────────────────────
CANONICAL_STORE_POSTGRES_USER=aggregator
CANONICAL_STORE_POSTGRES_PASSWORD=change-me-pg-password
CANONICAL_STORE_POSTGRES_DB=canonical

# ─────────────────────────────────────────────
# Token Service (port 8083)
# ─────────────────────────────────────────────
TOKEN_DB_DSN=postgres://tokenservice:change-me-token-pg-password@token-db:5432/tokendb

# Generate with: openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt | base64
ES256_PRIVATE_KEY_B64=change-me-base64-encoded-es256-private-key-pem

ACCESS_TOKEN_TTL=60            # seconds
REFRESH_TOKEN_TTL_DAYS=7

CLIENT_MEDIA_ID=client-media
CLIENT_MEDIA_SECRET=change-me-media-secret

CLIENT_FIELD_TEAM_ID=client-field-team
CLIENT_FIELD_TEAM_SECRET=change-me-field-team-secret

CLIENT_INTERNAL_OPS_ID=client-internal-ops
CLIENT_INTERNAL_OPS_SECRET=change-me-internal-ops-secret

TOKEN_SERVICE_PORT=8083

# ─────────────────────────────────────────────
# Token DB (PostgreSQL)
# ─────────────────────────────────────────────
TOKEN_DB_POSTGRES_USER=tokenservice
TOKEN_DB_POSTGRES_PASSWORD=change-me-token-pg-password
TOKEN_DB_POSTGRES_DB=tokendb

# ─────────────────────────────────────────────
# Client API (port 8080)
# ─────────────────────────────────────────────
CLIENT_API_AGGREGATOR_BASE_URL=http://aggregator:8090
CLIENT_API_JWKS_URL=http://token-service:8083/.well-known/jwks.json
CLIENT_API_RPS_LIMIT=100
CLIENT_API_BURST=20
CLIENT_API_PORT=8080

# ─────────────────────────────────────────────
# Consumers
# ─────────────────────────────────────────────
NATS_URL=nats://nats-jetstream:4222

NOTIFICATION_CONSUMER_STUB_SINK_URL=http://stub-sink:8085
NOTIFICATION_CONSUMER_BBOLT_PATH=/data/notification.db

AUDIT_CONSUMER_BBOLT_PATH=/data/audit.db

# ─────────────────────────────────────────────
# Stub Sink
# ─────────────────────────────────────────────
STUB_SINK_PORT=8085

# ─────────────────────────────────────────────
# Logging (all services)
# ─────────────────────────────────────────────
LOG_LEVEL=info
